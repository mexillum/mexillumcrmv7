# URL del despliegue de PRODUCCIÓN de Convex.
#
# Vite incrusta las VITE_* en tiempo de COMPILACIÓN, no de ejecución.
# Las "Variables and Secrets" del panel de Cloudflare son de ejecución,
# así que el build no las ve y el bundle salía sin URL.
#
# Este archivo se versiona a propósito: la URL de un despliegue de
# Convex no es un secreto — viaja dentro del bundle que sirve el
# navegador. Los secretos de verdad (JWT_PRIVATE_KEY, JWKS) viven en el
# despliegue de Convex, nunca aquí.
#
# En local manda .env.local (que apunta al despliegue de desarrollo),
# porque Vite le da más prioridad en todos los modos.
VITE_CONVEX_URL=https://scrupulous-bullfrog-389.convex.cloud
