{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mexillumcrmv7",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Dónde están los estáticos ya compilados. `wrangler deploy` NO
    // compila: hay que ejecutar `npm run build` antes (ver el script
    // "deploy" de package.json).
    "directory": "./dist",

    // La SPA de React Router necesita que cualquier ruta desconocida
    // devuelva index.html. Cloudflare lo hace de forma nativa con esto.
    //
    // NO añadir un archivo public/_redirects con "/* /index.html 200":
    // sobre Workers, Cloudflare lo lee como un bucle infinito y rechaza
    // el despliegue con el error 100324.
    "not_found_handling": "single-page-application"
  },

  // Dominio propio del CRM. Cloudflare crea y gestiona el registro DNS
  // de crm.mexillum.com automáticamente al desplegar (borra antes el
  // CNAME viejo que apuntaba a Railway, o el despliegue chocará).
  "routes": [
    {
      "pattern": "crm.mexillum.com",
      "custom_domain": true
    }
  ]
}
